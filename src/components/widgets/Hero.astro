---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative isolate md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div class="text-center md:text-left max-w-5xl mx-auto md:mx-0">
          {
            tagline && (
              <p
                data-reveal
                class="inline-flex items-center gap-2 mb-6 rounded-full border border-gray-200/80 dark:border-slate-700/80 bg-white/70 dark:bg-slate-900/60 backdrop-blur px-4 py-1.5 text-sm font-medium text-gray-700 dark:text-slate-300 shadow-sm"
              >
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping" />
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
                </span>
                <Fragment set:html={tagline} />
              </p>
            )
          }
          {
            title && (
              <h1
                data-reveal
                style="--reveal-delay: 100"
                class="text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.02] tracking-tight mb-6 font-heading text-gray-900 dark:text-white"
                set:html={title}
              />
            )
          }
          <div class="max-w-3xl mx-auto">
            {
              subtitle && (
                <p
                  data-reveal
                  style="--reveal-delay: 200"
                  class="text-lg md:text-xl text-muted mb-8 dark:text-slate-300 leading-relaxed"
                  set:html={subtitle}
                />
              )
            }
            {
              actions && (
                <div
                  data-reveal
                  style="--reveal-delay: 300"
                  class="max-w-xs sm:max-w-md m-auto md:m-0 flex flex-nowrap flex-col sm:flex-row sm:justify-center md:justify-start gap-4"
                >
                  {Array.isArray(actions) ? (
                    actions.map((action) => (
                      <div class="flex w-full sm:w-auto">
                        <Button {...(action || {})} class="w-full sm:mb-0" />
                      </div>
                    ))
                  ) : (
                    <Fragment set:html={actions} />
                  )}
                </div>
              )
            }
          </div>
          {content && <Fragment set:html={content} />}
        </div>
        <div data-reveal="zoom" style="--reveal-delay: 250">
          {
            image && (
              <div class="relative m-auto max-w-5xl animate-float">
                <div
                  class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-tr from-blue-500/30 via-violet-500/30 to-pink-400/30 blur-3xl"
                  aria-hidden="true"
                />
                {typeof image === 'string' ? (
                  <Fragment set:html={image} />
                ) : (
                  <Image
                    class="mx-auto rounded-3xl w-full ring-1 ring-black/5 dark:ring-white/10 shadow-2xl shadow-blue-900/20"
                    widths={[400, 768, 1024, 2040]}
                    sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                    loading="eager"
                    fetchpriority="high"
                    width={1024}
                    height={576}
                    format="webp"
                    {...image}
                  />
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
