---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Process from '~/components/widgets/Process.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Joan Andrivalisoa — Talent Acquisition Specialist',
};

const logos = [
  'agicap-tr.png',
  'agridom.png',
  'aligneurs_franais_logo.png',
  'animaj.png',
  'blumana.png',
  'Capture+d_E2_80_99e_CC_81cran+2026-02-11+a_CC_80+18.07.43.png',
  'cesam.png',
  'dune.png',
  'fringuant.png',
  'heyteam.png',
  'hyppo.png',
  'naboo-tr.png',
  'preveam.png',
  'revolv.png',
  'simplycure.png',
  'tilos.png',
  'time2scale.png',
  'trusk.png',
];

const stats = [
  { count: 6000, suffix: '+', label: 'Talents sourced per mission' },
  { count: 48, suffix: 'h', label: 'To first shortlist' },
  { count: 70, suffix: '%', label: 'Reduction in time-to-hire' },
  { count: 96, suffix: '%', label: 'Success rate' },
  { count: 10, suffix: '+', label: 'Years of recruitment expertise' },
];

const steps = [
  {
    title: 'Discovery & Role Scoping',
    description:
      'Deep dive into company culture, defining exact technical requirements, soft skills, and strategic expectations for the role.',
    icon: 'tabler:target-arrow',
    duration: 'Kick-off',
    deliverables: ['Role scorecard', 'Hiring plan'],
  },
  {
    title: 'Targeted Sourcing & Headhunting',
    description:
      'Multi-channel direct search across LinkedIn, niche networks, and talent pools to engage top active and passive candidates.',
    icon: 'tabler:radar-2',
    duration: 'Day 1–2',
    deliverables: ['Market mapping', 'Passive talent outreach'],
  },
  {
    title: 'Structured Interviews & Assessment',
    description:
      'In-depth screening and competency-based interviews evaluating technical expertise, motivational fit, and cultural alignment.',
    icon: 'tabler:user-search',
    duration: 'Ongoing',
    deliverables: ['Competency interviews', 'Culture-fit check'],
  },
  {
    title: 'Shortlist & Decision Support',
    description:
      'Delivering comprehensive candidate scorecards, managing stakeholder debriefs, and conducting thorough reference checks.',
    icon: 'tabler:checklist',
    duration: 'Within 48h',
    deliverables: ['Candidate scorecards', 'Reference checks'],
  },
  {
    title: 'Offer Negotiation & Onboarding',
    description:
      'Closing candidates, handling offer negotiations, and maintaining pre-onboarding touchpoints to ensure long-term retention.',
    icon: 'tabler:heart-handshake',
    duration: 'Closing & beyond',
    deliverables: ['Offer management', 'Onboarding follow-up'],
  },
];
---

<Layout metadata={metadata}>
  <!-- ==========================================
       SECTION 1 : HOME
       ========================================== -->
  <section
    id="home"
    class="relative isolate overflow-hidden min-h-screen flex flex-col justify-center bg-white dark:bg-slate-950 pt-16"
  >
    <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora-blob w-[36rem] h-[36rem] -top-32 -left-40 bg-blue-300/60"></div>
      <div class="aurora-blob w-[30rem] h-[30rem] top-24 right-0 bg-violet-300/60"></div>
      <div class="aurora-blob w-[26rem] h-[26rem] bottom-0 left-1/3 bg-pink-200/60"></div>
    </div>

    <Hero
      tagline='<span class="hidden sm:inline">Talent Acquisition Specialist · </span>Open to new missions'
      actions={[
        {
          variant: 'primary',
          text: 'Explore My Process',
          href: '#process',
          icon: 'tabler:arrow-down',
        },
        { text: 'Contact Me', href: '#contact' },
      ]}
      image={{ src: '~/assets/images/hero-image.png', alt: 'Joan Andrivalisoa - Talent Acquisition' }}
    >
      <Fragment slot="title">
        Joan Andrivalisoa
        <br />
        <span class="text-gradient">Talent</span>
        <span class="font-display-serif text-gray-900 dark:text-white ml-[0.2em]">Acquisition</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="font-semibold text-gray-900 dark:text-white">Talent acquisition made simple.</span>
        <br />
        Helping companies identify, attract, and hire top-tier talent through a human-centric, structured, and data-driven
        approach.
      </Fragment>
    </Hero>

    <a
      href="#impact"
      class="hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-xs uppercase tracking-[0.25em] text-gray-400 hover:text-primary transition-colors"
      aria-label="Scroll down"
    >
      Scroll
      <span class="relative h-10 w-6 rounded-full border-2 border-current">
        <span
          class="absolute left-1/2 top-2 h-2 w-1 -translate-x-1/2 rounded-full bg-current motion-safe:animate-bounce"
        ></span>
      </span>
    </a>
  </section>

  <!-- ==========================================
       SECTION 2 : TRUSTED BY + IMPACT
       ========================================== -->
  <section id="impact" class="relative scroll-mt-20 bg-white dark:bg-slate-950 py-20 md:py-28">
    <!-- A. Logo marquee -->
    <p data-reveal class="text-center text-sm font-medium uppercase tracking-[0.2em] text-gray-500 dark:text-slate-400">
      Trusted by fast-growing companies
    </p>
    <div
      data-reveal
      style="--reveal-delay: 100"
      class="marquee-mask relative mt-8 w-full overflow-hidden py-6 border-y border-gray-200/60 dark:border-slate-800"
    >
      <div class="flex w-max animate-marquee">
        {
          [0, 1].map((copy) => (
            <div class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((file, i) => (
                <img
                  src={`/logos/${file}`}
                  alt={copy === 0 ? `Client logo ${i + 1}` : ''}
                  loading="lazy"
                  decoding="async"
                  class="h-8 md:h-10 w-auto mx-10 md:mx-12 object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-500"
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- B. Impact in numbers -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-20 md:mt-28">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          data-reveal
          class="font-heading font-bold text-4xl md:text-5xl tracking-tight leading-[1.05] text-gray-900 dark:text-white"
        >
          Impact, <span class="font-display-serif text-gradient">in numbers</span>
        </h2>
        <p data-reveal style="--reveal-delay: 100" class="mt-4 text-lg text-muted dark:text-slate-400">
          Measurable results from a decade of hiring for startups and scale-ups.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-6">
        {
          stats.map((stat, i) => (
            <div
              data-reveal
              style={`--reveal-delay: ${i * 90}`}
              class:list={[
                'glow-card group text-center p-6 md:p-8 rounded-3xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-800',
                { 'col-span-2 md:col-span-1': i === stats.length - 1 },
              ]}
            >
              <p
                class="font-heading text-4xl md:text-5xl font-bold tracking-tight text-gradient tabular-nums"
                data-count={stat.count}
                data-suffix={stat.suffix}
              >
                {stat.count.toLocaleString('en-US')}
                {stat.suffix}
              </p>
              <p class="mt-3 text-xs md:text-sm text-muted dark:text-slate-400 font-medium leading-snug">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 3 : PROCESS
       ========================================== -->
  <Process
    id="process"
    tagline="The Process"
    title={'From first call&nbsp;<br class="hidden md:block" />to <span class="font-display-serif text-gradient">first day</span>.'}
    subtitle="A proven, transparent end-to-end framework — from requirement discovery to onboarding — so you always know what's next."
    steps={steps}
    action={{ text: 'Start your search', href: '#contact' }}
  />

  <!-- ==========================================
       SECTION 4 : CONTACT
       ========================================== -->
  <section
    id="contact"
    class="relative isolate overflow-hidden scroll-mt-20 min-h-screen flex flex-col justify-center bg-white dark:bg-slate-950 py-12"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="aurora-blob w-[30rem] h-[30rem] top-1/4 -left-40 bg-blue-300/50"></div>
      <div class="aurora-blob w-[28rem] h-[28rem] bottom-0 -right-32 bg-violet-300/50"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 w-full">
      <div class="max-w-3xl mx-auto">
        <ContactUs
          id="form"
          title={'Let\'s build your <span class="font-display-serif text-gradient">dream team</span>!'}
          subtitle="Drop me a line. I'll get back to you within 24 hours."
          inputs={[
            {
              type: 'text',
              name: 'name',
              label: 'Full Name',
            },
            {
              type: 'email',
              name: 'email',
              label: 'Email Address',
            },
          ]}
          textarea={{
            label: 'Tell me about your hiring needs',
          }}
          disclaimer={{
            label: 'By submitting this form, you agree to be contacted.',
          }}
          button="Send Message"
        />
      </div>
    </div>
  </section>
</Layout>
